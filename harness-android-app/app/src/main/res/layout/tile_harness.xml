<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/tile_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000"
    android:gravity="center"
    android:orientation="vertical"
    android:padding="20dp">

    <TextView
        android:id="@+id/tile_header"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="HARNESS // AGENT"
        android:textColor="#00E5FF"
        android:textSize="12sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/tile_agent_name"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:text="HERMES-01"
        android:textColor="#FFFFFF"
        android:textSize="20sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/tile_status"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:text="STATUS: STANDBY"
        android:textColor="#AAAAAA"
        android:textSize="11sp" />

    <TextView
        android:id="@+id/tile_btn_command"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:background="@drawable/bg_tile_button"
        android:paddingStart="16dp"
        android:paddingTop="8dp"
        android:paddingEnd="16dp"
        android:paddingBottom="8dp"
        android:text="[ COMMAND ]"
        android:textColor="#000000"
        android:textSize="13sp"
        android:textStyle="bold" />

</LinearLayout>
